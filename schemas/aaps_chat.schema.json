{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AAPS Studio Chat Router Response",
  "type": "object",
  "required": ["mode", "route", "message", "source", "files", "diagnostics"],
  "additionalProperties": false,
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["reply", "edit"]
    },
    "route": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "description": "Optional project-relative text files to materialize as part of an explicit chat edit.",
      "items": {
        "type": "object",
        "required": ["path", "content", "kind", "reason"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
